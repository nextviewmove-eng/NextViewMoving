# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/moving_company

# CORS origins
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# JWT
JWT_SECRET=development_change_this_secret
JWT_EXPIRES_IN=1d

# SMTP (email service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Let's Get Moving <quotes@example.com>"
ADMIN_NOTIFICATION_EMAIL=

# Cloudinary (document storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=